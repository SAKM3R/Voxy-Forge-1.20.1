@@ -0,0 +1,15 @@
+// Voxy: hand the LODs to the pack's Distant Horizons code paths (included right after #version in
+// every program, so it comes before any "#if defined DISTANT_HORIZONS")
+#if defined VOXY && !defined DISTANT_HORIZONS
+	#define DISTANT_HORIZONS
+	#define VOXY_DH
+	#define dhRenderDistance vxDhRenderDistance
+	#define dhNearPlane vxNearPlane
+	#define dhFarPlane vxFarPlane
+	#define dhProjection vxProj
+	#define dhProjectionInverse vxProjInv
+	#define dhPreviousProjection vxProjPrev
+	#define dhDepthTex vxDepthTexTrans
+	#define dhDepthTex0 vxDepthTexTrans
+	#define dhDepthTex1 vxDepthTexOpaque
+#endif
diff -ruN deriv/shaders/program/DH/Terrain.frag deriv_voxy/shaders/program/DH/Terrain.frag
--- deriv/shaders/program/DH/Terrain.frag	2024-04-03 22:56:06.000000000 +0300
+++ deriv_voxy/shaders/program/DH/Terrain.frag	2026-10-25 08:50:44.414857548 +0300
@@ -8,6 +8,14 @@
 #include "/lib/Head/Common.inc"
 
 
+#ifdef VOXY_PATCH
+	// Voxy LOD terrain: what DH/Terrain.vert would pass on is filled in from Voxy's fragment parameters
+	vec3 tint;
+	vec2 lightmap;
+	vec3 flatNormal;
+	vec3 worldPos;
+	uint materialIDs;
+#else
 in vec3 tint;
 
 in vec2 lightmap;
@@ -17,15 +25,29 @@
 
 flat in uint materialIDs;
 
+
 uniform int frameCounter;
 uniform float far;
+#endif
 
 float InterleavedGradientNoiseTemporal(in vec2 coord) {
     return fract(52.9829189 * fract(0.06711056 * coord.x + 0.00583715 * coord.y + 0.00623715 * (frameCounter & 63)));
 }
 
+#ifdef VOXY_PATCH
+void voxy_emitFragment(VoxyFragmentParameters parameters) {
+	tint = parameters.sampledColour.rgb * parameters.tinting.rgb;
+	lightmap = saturate((parameters.lightMap - 0.03125) * 1.06667);
+	uint axis = uint(parameters.face) >> 1u;
+	flatNormal = axis == 0u ? gbufferModelView[1].xyz : (axis == 1u ? gbufferModelView[2].xyz : gbufferModelView[0].xyz);
+	if ((parameters.face & 1u) == 0u) flatNormal = -flatNormal;
+	// Same ids as Gbuffers/Terrain.vert (block.properties id - 10000, plants and up count from 6)
+	materialIDs = uint(max(int(parameters.customId) - 10000, 0));
+	if (materialIDs > 0u) materialIDs = max(materialIDs, 6u);
+#else
 void main() {
     if (length(worldPos) < 0.8 * far) { discard; return; }
+#endif
 
 	vec3 albedo = tint;
 
